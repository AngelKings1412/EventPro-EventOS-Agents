@model EventPro.Models.Evento
@{
    ViewData["Title"] = "Editar Evento";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm p-4">
            <h1 class="mb-3"><i class="bi bi-pencil-square text-primary me-2"></i>Editar Evento</h1>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <partial name="_EventoFormFields" model="Model" />
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Actualizar Evento
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
