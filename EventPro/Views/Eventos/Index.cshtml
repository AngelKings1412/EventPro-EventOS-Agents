@model IEnumerable<EventPro.Models.Evento>
@{
    ViewData["Title"] = "Gestión de Eventos";
    bool puedeEditar = User.IsInRole("Administrador") || User.IsInRole("Planificador");
    bool esAdmin = User.IsInRole("Administrador");
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="mb-1">Catálogo de Eventos</h1>
        <p class="text-muted mb-0">Administración integral de eventos universitarios con integración directa al Orquestador IA.</p>
    </div>
    @if (puedeEditar)
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Registrar Evento
        </a>
    }
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Evento y Tipo</th>
                    <th>Cliente / Solicitante</th>
                    <th>Fechas</th>
                    <th>Lugar y Aforo</th>
                    <th>Techo Presupuestal</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var gastado = item.RubrosPresupuesto.Sum(r => r.MontoReal);
                    <tr>
                        <td>
                            <div class="fw-bold text-primary">@item.Nombre</div>
                            <span class="badge bg-info text-white">@item.Tipo</span>
                        </td>
                        <td><small>@(item.Cliente?.Nombre ?? "Sin asignar")</small></td>
                        <td>
                            <small class="d-block">@item.FechaInicio.ToString("dd/MM/yyyy")</small>
                            <small class="text-muted">al @item.FechaFin.ToString("dd/MM/yyyy")</small>
                        </td>
                        <td>
                            <div><small class="fw-semibold">@item.Lugar</small></div>
                            <span class="badge bg-light text-dark border">@item.Aforo personas</span>
                        </td>
                        <td>
                            <div class="fw-semibold">$@item.PresupuestoMaximo.ToString("N2")</div>
                            <small class="@(gastado > item.PresupuestoMaximo ? "text-danger fw-bold" : "text-muted")">Ejercido: $@gastado.ToString("N2")</small>
                        </td>
                        <td>
                            <span class="badge @(item.Estado == "Planificado" ? "bg-primary text-white" : item.Estado == "En coordinación" ? "bg-warning text-dark" : item.Estado == "Cancelado" ? "bg-danger text-white" : "bg-success text-white")">
                                @item.Estado
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                @if (puedeEditar)
                                {
                                    <a asp-controller="Agentes" asp-action="Index" asp-route-eventoId="@item.Id" class="btn btn-outline-dark" title="Orquestar con Agentes IA">
                                        <i class="bi bi-cpu"></i> IA
                                    </a>
                                }
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Detalles">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (puedeEditar)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }
                                @if (esAdmin)
                                {
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
