@model EventPro.Models.Evento
@{
    ViewData["Title"] = "Eliminar Evento";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-7">
        <div class="card p-4">
            <h1 class="text-danger mb-3">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Eliminación de Evento
            </h1>
            <p class="text-muted">
                ¿Estás seguro de eliminar el siguiente evento? Esta operación eliminará también sus rubros presupuestales, tareas, invitados, contrataciones y comunicados asociados en SQL Server.
            </p>
            <div class="ep-item-row mb-4">
                <h2 class="mb-1">@Model.Nombre</h2>
                <div class="small text-secondary">
                    <span class="me-3"><i class="bi bi-geo-alt"></i> @Model.Lugar</span>
                    <span class="me-3"><i class="bi bi-calendar"></i> @Model.FechaInicio.ToString("dd/MM/yyyy") - @Model.FechaFin.ToString("dd/MM/yyyy")</span>
                    <span><i class="bi bi-people"></i> Aforo: @Model.Aforo</span>
                </div>
            </div>
            <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-danger px-4">
                    <i class="bi bi-trash me-1"></i> Confirmar Eliminación
                </button>
            </form>
        </div>
    </div>
</div>
