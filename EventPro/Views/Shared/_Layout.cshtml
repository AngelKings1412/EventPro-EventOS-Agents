@using System.Security.Claims
@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool esAdmin = User.IsInRole("Administrador");
    bool esPlanificador = User.IsInRole("Planificador");
    bool puedeOperar = esAdmin || esPlanificador;
    string rolActual = User.FindFirstValue(ClaimTypes.Role) ?? "Usuario";
    string rolBadgeClass = esAdmin ? "bg-primary text-white" : esPlanificador ? "bg-success text-white" : "bg-secondary text-white";
    string rolDescripcion = esAdmin ? "Administrador · Control Total" : esPlanificador ? "Planificador · Gestión e IA" : "Cliente · Solo Consulta";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventPro + EventOS-Agents</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="ep-shell">
            <!-- Sidebar Lateral Responsivo con Menú Filtrado por Rol RBAC -->
            <aside class="offcanvas-lg offcanvas-start ep-sidebar" tabindex="-1" id="epSidebar" aria-label="Menú principal">
                <a class="ep-sidebar-brand" asp-controller="Dashboard" asp-action="Index">
                    <span class="fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-calendar-event-fill"></i>
                        <span>EventPro</span>
                    </span>
                    <span class="badge bg-primary text-white">IA Agents</span>
                </a>

                <nav class="ep-sidebar-nav">
                    <div class="ep-nav-section">Consulta y Seguimiento</div>
                    <a class="ep-sidebar-link @(ctrl == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2"></i><span>Dashboard</span>
                    </a>
                    <a class="ep-sidebar-link @(ctrl == "Eventos" ? "active" : "")" asp-controller="Eventos" asp-action="Index">
                        <i class="bi bi-calendar3"></i><span>Eventos</span>
                    </a>
                    <a class="ep-sidebar-link @(ctrl == "Presupuestos" ? "active" : "")" asp-controller="Presupuestos" asp-action="Index">
                        <i class="bi bi-cash-stack"></i><span>Presupuesto</span>
                    </a>
                    <a class="ep-sidebar-link @(ctrl == "Invitados" ? "active" : "")" asp-controller="Invitados" asp-action="Index">
                        <i class="bi bi-people"></i><span>Invitados</span>
                    </a>
                    <a class="ep-sidebar-link @(ctrl == "Comunicados" ? "active" : "")" asp-controller="Comunicados" asp-action="Index">
                        <i class="bi bi-envelope-paper"></i><span>Comunicados</span>
                    </a>
                    <a class="ep-sidebar-link @(ctrl == "Reportes" ? "active" : "")" asp-controller="Reportes" asp-action="Index">
                        <i class="bi bi-bar-chart-line"></i><span>Reportes</span>
                    </a>

                    @if (puedeOperar)
                    {
                        <div class="ep-nav-divider" role="separator"></div>
                        <div class="ep-nav-section">Operación e IA</div>
                        <a class="ep-sidebar-link @(ctrl == "Agentes" ? "active" : "")" asp-controller="Agentes" asp-action="Index">
                            <i class="bi bi-cpu-fill"></i><span>Agentes IA</span>
                        </a>
                        <a class="ep-sidebar-link @(ctrl == "Tareas" ? "active" : "")" asp-controller="Tareas" asp-action="Index">
                            <i class="bi bi-check2-square"></i><span>Tareas</span>
                        </a>
                        <a class="ep-sidebar-link @(ctrl == "Proveedores" ? "active" : "")" asp-controller="Proveedores" asp-action="Index">
                            <i class="bi bi-truck"></i><span>Proveedores</span>
                        </a>
                        <a class="ep-sidebar-link @(ctrl == "Clientes" ? "active" : "")" asp-controller="Clientes" asp-action="Index">
                            <i class="bi bi-building"></i><span>Clientes</span>
                        </a>
                    }

                    @if (esAdmin)
                    {
                        <div class="ep-nav-divider" role="separator"></div>
                        <div class="ep-nav-section">Administración</div>
                        <a class="ep-sidebar-link @(ctrl == "Bitacora" ? "active" : "")" asp-controller="Bitacora" asp-action="Index">
                            <i class="bi bi-journal-text"></i><span>Bitácora</span>
                        </a>
                        <a class="ep-sidebar-link @(ctrl == "Usuarios" ? "active" : "")" asp-controller="Usuarios" asp-action="Index">
                            <i class="bi bi-shield-lock"></i><span>Usuarios</span>
                        </a>
                    }
                </nav>
            </aside>

            <!-- Columna Principal -->
            <div class="ep-main">
                <header class="ep-topbar">
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-outline-secondary btn-sm d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#epSidebar" aria-label="Abrir menú">
                            <i class="bi bi-list"></i>
                        </button>
                        <span class="small fw-semibold text-muted">@ViewData["Title"]</span>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-person-circle text-muted d-none d-sm-inline"></i>
                        <span class="ep-user-name" title="@User.Identity.Name">@User.Identity.Name</span>
                        <span class="badge @rolBadgeClass" title="Rol activo: @rolActual">@rolDescripcion</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-box-arrow-right"></i> Salir
                            </button>
                        </form>
                    </div>
                </header>

                <main class="p-4 flex-grow-1">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                        </div>
                    }
                    @RenderBody()
                </main>

                <footer class="py-3 px-4 bg-white border-top text-center">
                    <small class="text-muted">EventPro + EventOS-Agents &copy; 2026 · ITESCA</small>
                </footer>
            </div>
        </div>
    }
    else
    {
        <main class="container py-5">
            @RenderBody()
        </main>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
