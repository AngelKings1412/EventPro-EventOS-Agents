@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6">
        <div class="card text-center p-5">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-exclamation" style="font-size: 4rem;"></i>
            </div>
            <h1 class="mb-2">Acceso Restringido por Rol</h1>
            <p class="text-muted mt-2 mb-4">
                Tu perfil actual no cuenta con los permisos necesarios para realizar esta acción o acceder a esta sección administrativa.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-house-door me-1"></i> Ir al Dashboard
                </a>
                @if (User.IsInRole("Administrador") || User.IsInRole("Planificador"))
                {
                    <a asp-controller="Agentes" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-cpu me-1"></i> Consola IA
                    </a>
                }
                else
                {
                    <a asp-controller="Eventos" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-calendar3 me-1"></i> Ver Eventos
                    </a>
                }
            </div>
        </div>
    </div>
</div>
