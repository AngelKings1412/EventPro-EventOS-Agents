@model IEnumerable<EventPro.Models.Cliente>
@{
    ViewData["Title"] = "Catálogo de Clientes";
    bool puedeEditar = User.IsInRole("Administrador") || User.IsInRole("Planificador");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Clientes y Dependencias Solicitantes</h1>
        <p class="text-muted mb-0">Administración de organizaciones, comités e instituciones que solicitan eventos.</p>
    </div>
</div>

@if (puedeEditar)
{
    <div class="card p-4 mb-4">
        <h2 class="mb-3">Registrar Nuevo Cliente</h2>
        <form asp-action="Create" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Nombre / Dependencia</label>
                <input name="Nombre" class="form-control" placeholder="Ej. Academia de Ingeniería Industrial" required />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Empresa / Institución</label>
                <input name="Empresa" class="form-control" placeholder="ITESCA / Sector Privado" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Correo Electrónico</label>
                <input name="Email" type="email" class="form-control" placeholder="contacto@itesca.edu.mx" required />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Teléfono</label>
                <input name="Telefono" class="form-control" placeholder="644-410-8600" />
            </div>
            <div class="col-12 text-end">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-person-plus me-1"></i> Guardar Cliente
                </button>
            </div>
        </form>
    </div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Empresa / Institución</th>
                    <th>Correo</th>
                    <th>Teléfono</th>
                    <th>Eventos Asociados</th>
                    @if (puedeEditar)
                    {
                        <th class="text-end">Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-bold text-primary">@c.Nombre</td>
                        <td>@c.Empresa</td>
                        <td>@c.Email</td>
                        <td>@c.Telefono</td>
                        <td><span class="badge bg-info text-white">@c.Eventos.Count evento(s)</span></td>
                        @if (puedeEditar)
                        {
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar cliente?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
